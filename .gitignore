# ==========================================
# Secure Scope - Git Ignore
# macOS / Windows / Linux
# ==========================================

# Environment variables and secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node.js / React / Vite
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE / Editors
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# Local databases
*.db
*.sqlite
*.sqlite3

# Logs and temporary files
*.log
tmp/
temp/
.cache/

# Docker local overrides
compose.override.yaml
docker-compose.override.yml

# Terraform (future extension)
.terraform/
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local certificates and keys
*.pem
*.key
*.p12
*.pfx
